<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="pizzaPoject"/>
        <attribute name="authors" value="workp"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-05 09:19:05 PM"/>
        <attribute name="created" value="d29ya3A7VEVDSE5PTE9HWS1SRVM7MjAyNi0xMC0wNTsxMjo0MDowMSBQTTsyODc0"/>
        <attribute name="edited" value="d29ya3A7VEVDSE5PTE9HWS1SRVM7MjAyNi0xMC0wNTswOToxOTowNSBQTTsxOzI5OTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="name" type="String" array="False" size=""/>
            <input variable="name"/>
            <declare name="Size" type="String" array="False" size=""/>
            <input variable="Size"/>
            <declare name="smal" type="Real" array="False" size=""/>
            <assign variable="smal" expression="3.25"/>
            <declare name="medium" type="Real" array="False" size=""/>
            <assign variable="medium" expression="5.50"/>
            <declare name="large" type="Real" array="False" size=""/>
            <assign variable="large" expression="7.15"/>
            <declare name="extraTopping" type="Real" array="False" size=""/>
            <declare name="totalcost" type="Real" array="False" size=""/>
            <if expression="smal == 3.25">
                <then>
                    <declare name="quen" type="Real" array="False" size=""/>
                    <input variable="quen"/>
                    <declare name="topping" type="Real" array="False" size=""/>
                    <input variable="extraTopping"/>
                    <if expression="extraTopping == 1">
                        <then>
                            <declare name="delivery" type="Real" array="False" size=""/>
                            <assign variable="Delivery" expression="2.5"/>
                            <assign variable="totalcost" expression="delivery + smal * quen +  0.75"/>
                            <if expression="Delivery = 2.5">
                                <then>
                                    <assign variable="totalcost" expression="smal * quen  + 0.75 + 2.50"/>
                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                    <if expression="totalcost &gt;= 20">
                                        <then>
                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                        </then>
                                        <else/>
                                    </if>
                                </then>
                                <else/>
                            </if>
                        </then>
                        <else>
                            <if expression="extraTopping == 2">
                                <then/>
                                <else>
                                    <if expression="extraTopping == 3">
                                        <then>
                                            <declare name="delivery" type="Real" array="False" size=""/>
                                            <assign variable="delivery" expression="2.5"/>
                                            <assign variable="totalcost" expression="2.5 + smal * quen + 2"/>
                                            <if expression="delivery == 2.5">
                                                <then>
                                                    <assign variable="totalcost" expression="smal * quen  + 2 + delivery"/>
                                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                                    <if expression="totalcost &gt;= 20">
                                                        <then>
                                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </then>
                                                <else/>
                                            </if>
                                        </then>
                                        <else>
                                            <if expression="extraTopping &gt;= 4">
                                                <then/>
                                                <else/>
                                            </if>
                                            <declare name="delivery" type="Real" array="False" size=""/>
                                            <assign variable="delivery" expression="2.5"/>
                                            <assign variable="totalcost" expression="delivery + smal * quen + 2.50"/>
                                            <if expression="delivery == 2.5">
                                                <then>
                                                    <assign variable="totalcost" expression="smal * quen + 2 + delivery"/>
                                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                                    <if expression="totalcost &gt;= 20">
                                                        <then>
                                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </then>
                                                <else/>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                            <declare name="delivery" type="Real" array="False" size=""/>
                            <assign variable="delivery" expression="2.5"/>
                            <assign variable="totalcost" expression="delivery + smal * quen + 1.35"/>
                            <if expression="delivery == 2.5">
                                <then>
                                    <assign variable="totalcost" expression="smal * quen  + 1.35 + delivery"/>
                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                    <if expression="totalcost &gt;= 20">
                                        <then>
                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                        </then>
                                        <else/>
                                    </if>
                                </then>
                                <else/>
                            </if>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="medium = 5.50">
                        <then>
                            <declare name="quen" type="Real" array="False" size=""/>
                            <input variable="quen"/>
                            <declare name="topping" type="Real" array="False" size=""/>
                            <input variable="extraTopping"/>
                            <if expression="extraTopping == 1">
                                <then>
                                    <declare name="delivery" type="Real" array="False" size=""/>
                                    <assign variable="delivery" expression="2.5"/>
                                    <assign variable="totalcost" expression="2.5 + medium * quen +  0.75"/>
                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                    <if expression="delivery == 2.5">
                                        <then>
                                            <assign variable="totalcost" expression="medium * quen + 0.75 + delivery"/>
                                            <if expression="totalcost &gt;= 20">
                                                <then>
                                                    <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                </then>
                                                <else/>
                                            </if>
                                        </then>
                                        <else/>
                                    </if>
                                </then>
                                <else>
                                    <if expression="extraTopping == 2">
                                        <then/>
                                        <else>
                                            <if expression="extraTopping == 3">
                                                <then>
                                                    <declare name="delivery" type="Real" array="False" size=""/>
                                                    <assign variable="delivery" expression="2.5"/>
                                                    <assign variable="totalcost" expression="delivery + medium * quen + 2"/>
                                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                                    <if expression="delivery == 2.5">
                                                        <then>
                                                            <assign variable="totalcost" expression="medium * quen  + 2 + delivery"/>
                                                            <if expression="totalcost &gt;= 20">
                                                                <then>
                                                                    <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                                </then>
                                                                <else/>
                                                            </if>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </then>
                                                <else>
                                                    <if expression="extraTopping &gt;= 4">
                                                        <then/>
                                                        <else/>
                                                    </if>
                                                    <declare name="delivery" type="Real" array="False" size=""/>
                                                    <assign variable="delivery" expression="2.5"/>
                                                    <assign variable="totalcost" expression="2.5 + medium * quen + 2"/>
                                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                                    <if expression="delivery == 2.5">
                                                        <then>
                                                            <assign variable="totalcost" expression="medium * quen + 2.5 + delivery"/>
                                                            <if expression="totalcost &gt;= 20">
                                                                <then>
                                                                    <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                                </then>
                                                                <else/>
                                                            </if>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
