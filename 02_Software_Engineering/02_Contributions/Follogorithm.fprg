                                    <declare name="delivery" type="Real" array="False" size=""/>
                                    <assign variable="delivery" expression="2.5"/>
                                    <assign variable="totalcost" expression="2.5 + medium * quen + 1.35"/>
                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                    <if expression="delivery == 2.5">
                                        <then>
                                            <assign variable="totalcost" expression="medium * quen  + 1.35 + delivery"/>
                                            <if expression="totalcost &gt;= 20">
                                                <then>
                                                    <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                </then>
                                                <else/>
                                            </if>
                                        </then>
                                        <else/>
                                    </if>
                                </else>
                            </if>
                        </then>
                        <else>
                            <if expression="large = 7.15">
                                <then>
                                    <declare name="quen" type="Real" array="False" size=""/>
                                    <input variable="quen"/>
                                    <declare name="topping" type="Real" array="False" size=""/>
                                    <input variable="extraTopping"/>
                                    <if expression="extraTopping == 1">
                                        <then>
                                            <declare name="delivery" type="Real" array="False" size=""/>
