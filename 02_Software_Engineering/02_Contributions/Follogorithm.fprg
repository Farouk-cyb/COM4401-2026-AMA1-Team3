                                            <assign variable="totalcost" expression="2.5 + large * quen +  0.75"/>
                                            <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                            <if expression="delivery == 2.5">
                                                <then>
                                                    <assign variable="totalcost" expression="large * quen + 0.75 + delivery"/>
                                                    <if expression="totalcost &gt;= 20">
                                                        <then>
                                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </then>
                                                <else/>
                                            </if>
                                        </then>
                                        <else>
                                            <if expression="extraTopping == 2">
                                                <then/>
                                                <else>
                                                    <if expression="extraTopping == 3">
                                                        <then>
                                                            <declare name="delivery" type="Real" array="False" size=""/>
                                                            <assign variable="delivery" expression="2.5"/>
                                                            <assign variable="totalcost" expression="delivery + large * quen + 2"/>
                                                            <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                                            <if expression="delivery == 2.5">
                                                                <then>
                                                                    <assign variable="totalcost" expression="large * quen  + 2 + delivery"/>
                                                                    <if expression="totalcost &gt;= 20">
                                                                        <then>
                                                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                                        </then>
                                                                        <else/>
                                                                    </if>
                                                                </then>
                                                                <else/>
                                                            </if>
                                                        </then>
                                                        <else>
                                                            <if expression="extraTopping &gt;= 4">
                                                                <then/>
                                                                <else/>
                                                            </if>
                                                            <declare name="delivery" type="Real" array="False" size=""/>
                                                            <assign variable="delivery" expression="2.5"/>
                                                            <assign variable="totalcost" expression="delivery + large * quen + 2.50"/>
                                                            <if expression="delivery == 2.5">
                                                                <then>
                                                                    <assign variable="totalcost" expression="large * quen  + 2.5 + delivery"/>
                                                                    <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                                                    <if expression="totalcost &gt;= 20">
                                                                        <then>
                                                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                                        </then>
                                                                        <else/>
                                                                    </if>
                                                                </then>
                                                                <else/>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                            <declare name="delivery" type="Real" array="False" size=""/>
                                            <assign variable="delivery" expression="2.5"/>
                                            <assign variable="totalcost" expression="2.5 + large * quen + 1.35"/>
                                            <declare name="CostAfterDiscount" type="Real" array="False" size=""/>
                                            <if expression="delivery == 2.5">
                                                <then>
                                                    <assign variable="totalcost" expression="large * quen  + 1.35 + delivery"/>
                                                    <if expression="totalcost &gt;= 20">
                                                        <then>
                                                            <assign variable="CostAfterDiscount" expression="totalcost / 10 * 9"/>
                                                        </then>
                                                        <else/>
                                                    </if>
                                                </then>
                                                <else/>
                                            </if>
                                        </else>
                                    </if>
                                </then>
                                <else/>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
